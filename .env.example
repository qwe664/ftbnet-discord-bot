# ===== Pterodactyl / Calagopus 面板設定 =====
PTERO_PANEL_URL=https://panel.ftbnet.net
PTERO_API_KEY=貼上你新申請的APIKey
SERVER_UUID=貼上FTBNet伺服器的完整UUID

# ===== Discord 機器人設定 =====
DISCORD_BOT_TOKEN=貼上你新申請的DiscordBotToken
CONTROL_CHANNEL_ID=貼上指令專用頻道ID
ADMIN_ROLE_ID=貼上admin身分組ID
STATS_CHANNEL_ID=貼上伺服器狀態頻道ID
INFO_CHANNEL_ID=貼上伺服器資訊公告頻道ID

# ===== Minecraft 伺服器連線資訊 =====
MC_HOST=play.ftbnet.net
MC_PORT=25565
